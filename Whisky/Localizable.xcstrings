    "Reports high-end GPU to pass launcher compatibility checks. Fixes EA App black screen and \"GPU not supported\" errors." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبلّغ عن GPU عالي الأداء لتجاوز فحوصات توافق المشغّلات. يصلح الشاشة السوداء في EA App وأخطاء «GPU غير مدعوم»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásí výkonné GPU, aby prošly kontroly launcherů. Opravuje černou obrazovku EA App a chyby „GPU not supported“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplyser en kraftig GPU, så launcheres tjek består. Retter sort skærm i EA App og fejl om GPU, der ikke understøttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet eine High-End-GPU für Launcher-Prüfungen. Behebt schwarze Bildschirme der EA App und „GPU nicht unterstützt“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports high-end GPU to pass launcher compatibility checks. Fixes EA App black screen and \"GPU not supported\" errors."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports high-end GPU to pass launcher compatibility checks. Fixes EA App black screen and \"GPU not supported\" errors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simula una GPU de gama alta para superar las comprobaciones de los lanzadores. Corrige la pantalla negra de EA App."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoittaa tehokkaan GPU:n yhteensopivuustarkistuksia varten. Korjaa EA Appin mustan ruudun ja GPU-virheilmoitukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simule un GPU haut de gamme pour les contrôles des lanceurs. Corrige l'écran noir et les erreurs GPU d'EA App."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichiara una GPU di fascia alta per superare i controlli dei launcher. Corregge la schermata nera di EA App."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高性能な GPU として報告し、ランチャーの互換性チェックを通過させます。EA App の黒画面や「GPU not supported」エラーを修正します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고성능 GPU로 보고해 런처의 호환성 검사를 통과시킵니다. EA App의 검은 화면과 “GPU not supported” 오류를 수정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt een high-end GPU om launchercontroles te doorstaan. Verhelpt zwarte schermen in EA App en 'GPU niet ondersteund'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłasza wydajny GPU, aby przejść testy zgodności launcherów. Naprawia czarny ekran EA App i błędy „GPU not supported”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa uma GPU de ponta para passar nas verificações dos launchers. Corrige a tela preta do EA App."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunica uma GPU topo de gama para passar as verificações dos launchers. Corrige o ecrã preto do EA App."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportează o placă video de top pentru a trece verificările launcherelor. Remediază ecranul negru din EA App."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает о мощном GPU, чтобы пройти проверки лаунчеров. Устраняет чёрный экран EA App и ошибки «GPU not supported»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger ett kraftfullt grafikkort så att launchers kontroller godkänns. Åtgärdar svart skärm i EA App och GPU-fel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumluluk denetimini geçmek için üst düzey GPU bildirir. EA App siyah ekranı ve “GPU desteklenmiyor” hatasını giderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє про потужний GPU, щоб пройти перевірки лаунчерів. Усуває чорний екран EA App і помилки «GPU not supported»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo GPU cao cấp để vượt kiểm tra của trình khởi chạy. Khắc phục màn hình đen EA App và lỗi “GPU not supported”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告为高端 GPU 以通过启动器的兼容性检查。修复 EA App 黑屏和“GPU not supported”错误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回報為高階 GPU 以通過啟動器的相容性檢查。修正 EA App 黑畫面與「GPU not supported」錯誤。"
          }
        }
      }
    },
