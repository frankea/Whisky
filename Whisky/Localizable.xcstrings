    "Sets SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 to preserve native button layouts for PlayStation and Switch controllers instead of converting to XInput format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 للحفاظ على تخطيط الأزرار الأصلي لوحدات تحكم PlayStation وSwitch بدلًا من تحويلها إلى تنسيق XInput."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, aby zůstalo původní značení tlačítek ovladačů PlayStation a Switch místo převodu na formát XInput."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, så den oprindelige knapplacering på PlayStation- og Switch-controllere bevares i stedet for at blive konverteret til XInput-format."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, um die native Tastenbelegung von PlayStation- und Switch-Controllern beizubehalten, statt sie ins XInput-Format zu übersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para conservar la disposición original de los botones de los mandos de PlayStation y Switch en lugar de convertirla al formato XInput."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, jolloin PlayStation- ja Switch-ohjaimien alkuperäiset painikemerkinnät säilyvät eikä niitä muunneta XInput-muotoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 pour conserver la disposition d'origine des boutons des manettes PlayStation et Switch au lieu de la convertir au format XInput."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 per mantenere la disposizione originale dei tasti dei controller PlayStation e Switch invece di convertirla nel formato XInput."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 を設定し、PlayStation および Switch のコントローラのボタン配列を XInput 形式に変換せず、そのまま維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1을 설정해 PlayStation 및 Switch 컨트롤러의 버튼 배열을 XInput 형식으로 변환하지 않고 그대로 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 in om de oorspronkelijke knopindeling van PlayStation- en Switch-controllers te behouden in plaats van deze om te zetten naar XInput."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, aby zachować oryginalne oznaczenia przycisków kontrolerów PlayStation i Switch zamiast zamiany na format XInput."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para preservar o layout original dos botões dos controles de PlayStation e Switch em vez de convertê-lo para o formato XInput."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para manter a disposição original dos botões dos comandos PlayStation e Switch em vez de a converter para o formato XInput."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 pentru a păstra dispunerea originală a butoanelor la controllerele PlayStation și Switch, în loc să o convertească în format XInput."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, чтобы сохранить обозначения кнопок контроллеров PlayStation и Switch вместо перевода в формат XInput."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 så att den ursprungliga knapplayouten på PlayStation- och Switch-handkontroller behålls i stället för att omvandlas till XInput-format."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation ve Switch kumandalarında XInput biçimine dönüştürmek yerine yerel düğme düzenlerini korumak için SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, щоб зберегти рідні позначення кнопок контролерів PlayStation і Switch замість перетворення на формат XInput."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 để giữ bố cục nút gốc của tay cầm PlayStation và Switch thay vì chuyển sang định dạng XInput."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1，保留 PlayStation 和 Switch 控制器的原生按键布局，而不转换为 XInput 格式。"
          }
