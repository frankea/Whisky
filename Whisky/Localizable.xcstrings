    "bottle.orphaned.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الزجاجات موجودة على القرص لكنها ليست في مكتبتك: %@. تؤدي إعادة الاستيراد إلى إضافتها مجددًا إلى الشريط الجانبي، ولا يتغير أي شيء على القرص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto lahve jsou na disku, ale nejsou ve vaší knihovně: %@. Opětovný import je vrátí do postranního panelu; na disku se nic nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse flasker findes på disken, men ikke i dit bibliotek: %@. Importerer du dem igen, kommer de tilbage i indholdsoversigten; intet på disken ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Flaschen liegen auf der Festplatte, fehlen aber in deiner Übersicht: %@. Beim erneuten Importieren erscheinen sie wieder in der Seitenleiste; auf der Festplatte ändert sich nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These bottles exist on disk but aren't in your library: %@. Re-importing adds them back to the sidebar; nothing on disk is changed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These bottles exist on disk but aren't in your library: %@. Re-importing adds them back to the sidebar; nothing on disk is changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas botellas están en el disco pero no en tu biblioteca: %@. Al reimportarlas vuelven a la barra lateral; no se modifica nada en el disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä pullot ovat levyllä, mutta eivät kirjastossasi: %@. Uudelleentuonti lisää ne takaisin sivupalkkiin; levyllä olevaan ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces bouteilles existent sur le disque mais ne figurent pas dans votre bibliothèque : %@. Les réimporter les rajoute à la barre latérale ; rien n'est modifié sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste bottiglie esistono sul disco ma non sono nella tua libreria: %@. Reimportandole tornano nella barra laterale; sul disco non cambia nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの Bottle はディスク上にありますが、ライブラリには登録されていません: %@。再インポートするとサイドバーに戻ります。ディスク上のデータは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Bottle들은 디스크에 있지만 라이브러리에는 없습니다: %@. 다시 가져오면 사이드바에 추가되며, 디스크의 내용은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze flessen staan op de schijf, maar niet in je bibliotheek: %@. Door ze opnieuw te importeren komen ze terug in de navigatiekolom; op de schijf verandert er niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te butelki są na dysku, ale nie ma ich w bibliotece: %@. Ponowny import doda je z powrotem do panelu bocznego; na dysku nic się nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas Bottles existem no disco, mas não estão na sua biblioteca: %@. Reimportá-las as devolve à barra lateral; nada é alterado no disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas Bottles existem no disco mas não estão na sua biblioteca: %@. Ao reimportá-las, voltam à barra lateral; nada é alterado no disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste sticle există pe disc, dar nu sunt în biblioteca ta: %@. Reimportarea le adaugă înapoi în bara laterală; nimic de pe disc nu se modifică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти бутылки есть на диске, но отсутствуют в вашей библиотеке: %@. Повторный импорт вернёт их в боковое меню; на диске ничего не изменится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här flaskorna finns på disken men saknas i ditt bibliotek: %@. Importerar du om dem läggs de tillbaka i sidofältet; inget på disken ändras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu şişeler diskte var ancak kitaplığınızda yok: %@. Yeniden içe aktarmak onları kenar çubuğuna geri ekler; diskteki hiçbir şey değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці пляшки є на диску, але їх немає у вашій бібліотеці: %@. Повторний імпорт поверне їх на бічну панель; на диску нічого не зміниться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bottle này có trên ổ đĩa nhưng không có trong thư viện: %@. Nhập lại sẽ đưa chúng trở lại thanh bên; dữ liệu trên ổ đĩa không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些 Bottle 存在于磁盘上，但不在你的资料库中：%@。重新导入会将它们加回边栏；磁盘上的内容不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些 Bottle 存在於磁碟上，但不在你的清單中：%@。重新匯入會將它們加回側邊欄；磁碟上的內容不會變動。"
          }
        }
      }
    },
