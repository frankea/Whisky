    "process.confirm.forceStop.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إنهاء جميع العمليات فورًا دون حفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny procesy budou okamžitě ukončeny bez uložení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle processer bliver afbrudt med det samme uden at arkivere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Prozesse sofort und ohne Sichern beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will immediately terminate all processes without saving."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will immediately terminate all processes without saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrarán de inmediato todos los procesos sin guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä lopettaa kaikki prosessit välittömästi tallentamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les processus seront immédiatement interrompus sans enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i processi verranno terminati immediatamente senza salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存せずにすべてのプロセスをただちに終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않고 모든 프로세스를 즉시 종료합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle processen direct beëindigd zonder te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie procesy zostaną natychmiast zakończone bez zapisywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os processos serão encerrados imediatamente, sem salvar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os processos serão terminados de imediato, sem guardar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate procesele vor fi oprite imediat, fără salvare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все процессы будут немедленно завершены без сохранения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla processer avslutas omedelbart utan att spara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, tüm işlemleri kaydetmeden hemen sonlandırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі процеси буде негайно завершено без збереження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ kết thúc ngay mọi tiến trình mà không lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将立即终止所有进程，且不会存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會立即終止所有程序，且不會儲存任何內容。"
          }
        }
      }
