    "Sets SDL_JOYSTICK_HIDAPI=0 to force SDL to use alternative input backends. May improve detection for some controllers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط SDL_JOYSTICK_HIDAPI=0 لإجبار SDL على استخدام واجهات إدخال بديلة. قد يحسّن ذلك اكتشاف بعض وحدات التحكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví SDL_JOYSTICK_HIDAPI=0, aby SDL použila jiné vstupní backendy. U některých ovladačů to zlepší rozpoznání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter SDL_JOYSTICK_HIDAPI=0, så SDL bruger andre input-backends. Det kan forbedre registreringen af nogle controllere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt SDL_JOYSTICK_HIDAPI=0, damit SDL alternative Eingabe-Backends verwendet. Kann die Erkennung mancher Controller verbessern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_JOYSTICK_HIDAPI=0 para forzar a SDL a usar otros backends de entrada. Puede mejorar la detección de algunos mandos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa SDL_JOYSTICK_HIDAPI=0, jolloin SDL käyttää vaihtoehtoisia syötetaustajärjestelmiä. Voi parantaa joidenkin ohjaimien tunnistusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit SDL_JOYSTICK_HIDAPI=0 pour forcer SDL à utiliser d'autres backends d'entrée. Peut améliorer la détection de certaines manettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta SDL_JOYSTICK_HIDAPI=0 per forzare SDL a usare backend di input alternativi. Può migliorare il rilevamento di alcuni controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDL_JOYSTICK_HIDAPI=0 を設定し、SDL に別の入力バックエンドを使用させます。一部のコントローラで検出が改善する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDL_JOYSTICK_HIDAPI=0을 설정해 SDL이 다른 입력 백엔드를 사용하도록 합니다. 일부 컨트롤러의 감지가 개선될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt SDL_JOYSTICK_HIDAPI=0 in zodat SDL andere invoerbackends gebruikt. Dit kan de detectie van sommige controllers verbeteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia SDL_JOYSTICK_HIDAPI=0, aby SDL korzystała z innych metod wejścia. Czasem poprawia to wykrywanie kontrolerów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_JOYSTICK_HIDAPI=0 para forçar o SDL a usar outros backends de entrada. Pode melhorar a detecção de alguns controles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define SDL_JOYSTICK_HIDAPI=0 para forçar o SDL a usar outros backends de entrada. Pode melhorar a deteção de alguns comandos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează SDL_JOYSTICK_HIDAPI=0 pentru a forța SDL să folosească alte backenduri de intrare. Poate îmbunătăți detectarea unor controllere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт SDL_JOYSTICK_HIDAPI=0, чтобы SDL использовала другие способы ввода. Иногда помогает распознать контроллер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger SDL_JOYSTICK_HIDAPI=0 så att SDL använder andra inmatningsbackends. Det kan förbättra identifieringen av vissa handkontroller."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDL'nin alternatif giriş arka uçlarını kullanmasını zorlamak için SDL_JOYSTICK_HIDAPI=0 ayarlar. Bazı kumandalarda algılamayı iyileştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає SDL_JOYSTICK_HIDAPI=0, щоб SDL використовувала інші способи вводу. Іноді це допомагає розпізнати контролер."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt SDL_JOYSTICK_HIDAPI=0 để buộc SDL dùng backend nhập liệu thay thế. Có thể cải thiện khả năng nhận diện một số tay cầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 SDL_JOYSTICK_HIDAPI=0，强制 SDL 使用其他输入后端。可能改善部分控制器的识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 SDL_JOYSTICK_HIDAPI=0，強制 SDL 使用其他輸入後端。可能改善部分控制器的偵測。"
          }
        }
      }
    },
