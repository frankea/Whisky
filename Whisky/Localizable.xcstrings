    "config.retinaMode.unknownHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«غير معروف» يعني الوراثة من بادئة Wine."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neznámé“ znamená převzetí z prefixu Wine."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukendt betyder, at indstillingen arves fra Wine-præfikset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Unbekannt“ bedeutet: vom Wine-Präfix übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown means inherit from the Wine prefix."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown means inherit from the Wine prefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconocido significa heredar del prefijo de Wine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuntematon tarkoittaa, että asetus peritään Wine-etuliitteestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inconnu signifie hériter du préfixe Wine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sconosciuto significa ereditare dal prefisso Wine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「不明」は Wine プレフィックスの設定を引き継ぐという意味です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘알 수 없음’은 Wine 프리픽스 설정을 따른다는 뜻입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Onbekend' betekent: overnemen van de Wine-prefix."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nieznany” oznacza dziedziczenie z prefiksu Wine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconhecido significa herdar do prefixo do Wine."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconhecido significa herdar do prefixo do Wine."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necunoscut înseamnă moștenire din prefixul Wine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Неизвестно» означает наследование из префикса Wine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okänt betyder att inställningen ärvs från Wine-prefixet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinmiyor, ayarın Wine ön ekinden devralınacağı anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Невідомо» означає успадкування з префікса Wine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không rõ nghĩa là kế thừa từ prefix Wine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“未知”表示沿用 Wine 前缀中的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「未知」表示沿用 Wine 前綴中的設定。"
          }
        }
      }
    },
