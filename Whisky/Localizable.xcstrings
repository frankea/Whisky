    "config.buildVersion.info" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رقم بنية Windows الذي يبلّغ عنه Wine. اتركه بدون تعيين ما لم يتطلب برنامج بنية معينة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číslo sestavení Windows, které Wine hlásí. Nenastavujte, pokud program nevyžaduje konkrétní sestavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det Windows-buildnummer, som Wine oplyser. Lad det være tomt, medmindre et program kræver et bestemt build."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
