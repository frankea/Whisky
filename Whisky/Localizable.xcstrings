    "config.graphics.backend.d3dMetal.missingWarning" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الزجاجة مضبوطة على D3DMetal، وهو غير مضمّن في المحرك المثبت. ستعود الألعاب إلى WineD3D الذي لا يستطيع تشغيل ألعاب DirectX 11 — بدّل إلى DXMT أو DXVK."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato láhev má nastavený D3DMetal, který nainstalované prostředí neobsahuje. Hry přejdou na WineD3D, který neumí hry s DirectX 11 — přepněte na DXMT nebo DXVK."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne flaske er indstillet til D3DMetal, som ikke findes i den installerede engine. Spil falder tilbage til WineD3D, der ikke kan køre DirectX 11-titler — skift til DXMT eller DXVK."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Flasche ist D3DMetal eingestellt, das in der installierten Engine nicht enthalten ist. Spiele weichen auf WineD3D aus, das keine DirectX-11-Titel ausführen kann – wechsle zu DXMT oder DXVK."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bottle is set to D3DMetal, which the installed engine doesn't include. Games will fall back to WineD3D, which can't run DirectX 11 titles — switch to DXMT or DXVK."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bottle is set to D3DMetal, which the installed engine doesn't include. Games will fall back to WineD3D, which can't run DirectX 11 titles — switch to DXMT or DXVK."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta botella usa D3DMetal, que el motor instalado no incluye. Los juegos recurrirán a WineD3D, que no puede ejecutar títulos DirectX 11: cambia a DXMT o DXVK."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä pullo on asetettu käyttämään D3DMetalia, jota asennettu moottori ei sisällä. Pelit siirtyvät WineD3D:hen, joka ei pysty ajamaan DirectX 11 -pelejä — vaihda DXMT:hen tai DXVK:hon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette bouteille utilise D3DMetal, absent du moteur installé. Les jeux basculeront sur WineD3D, qui ne peut pas exécuter les titres DirectX 11 — passez à DXMT ou DXVK."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa bottiglia è impostata su D3DMetal, che il motore installato non include. I giochi useranno WineD3D, che non può eseguire i titoli DirectX 11: passa a DXMT o DXVK."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Bottle は D3DMetal に設定されていますが、インストール済みのエンジンには含まれていません。ゲームは WineD3D にフォールバックし、DirectX 11 のタイトルは実行できません。DXMT または DXVK に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Bottle은 D3DMetal로 설정되어 있지만 설치된 엔진에는 포함되어 있지 않습니다. 게임은 WineD3D로 대체 실행되어 DirectX 11 타이틀을 실행할 수 없습니다. DXMT 또는 DXVK로 전환하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze fles is ingesteld op D3DMetal, dat niet in de geïnstalleerde engine zit. Games vallen terug op WineD3D, dat geen DirectX 11-titels kan draaien — schakel over naar DXMT of DXVK."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta butelka ma ustawiony D3DMetal, którego nie zawiera zainstalowany silnik. Gry przełączą się na WineD3D, który nie obsługuje DirectX 11 — wybierz DXMT lub DXVK."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Bottle está definida para D3DMetal, que o motor instalado não inclui. Os jogos vão recorrer ao WineD3D, que não roda títulos DirectX 11 — mude para DXMT ou DXVK."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Bottle está definida para D3DMetal, que o motor instalado não inclui. Os jogos vão recorrer ao WineD3D, que não consegue executar títulos DirectX 11 — mude para DXMT ou DXVK."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această sticlă este setată pe D3DMetal, care nu este inclus în motorul instalat. Jocurile vor folosi WineD3D, care nu poate rula titluri DirectX 11 — treci la DXMT sau DXVK."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой бутылки выбран D3DMetal, которого нет в установленной среде. Игры переключатся на WineD3D, который не поддерживает DirectX 11 — выберите DXMT или DXVK."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här flaskan är inställd på D3DMetal, som inte ingår i den installerade motorn. Spel faller tillbaka på WineD3D, som inte kan köra DirectX 11-titlar — byt till DXMT eller DXVK."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu şişe D3DMetal olarak ayarlı, ancak yüklü motor bunu içermiyor. Oyunlar WineD3D'ye geri döner ve DirectX 11 oyunları çalışmaz — DXMT veya DXVK'ya geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цієї пляшки вибрано D3DMetal, якого немає у встановленому рушії. Ігри перейдуть на WineD3D, що не підтримує DirectX 11 — виберіть DXMT або DXVK."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottle này được đặt dùng D3DMetal, nhưng engine đã cài không có sẵn. Game sẽ lùi về WineD3D, vốn không chạy được game DirectX 11 — hãy chuyển sang DXMT hoặc DXVK."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Bottle 设为使用 D3DMetal，但已安装的引擎并不包含它。游戏会回退到 WineD3D，而它无法运行 DirectX 11 游戏 — 请改用 DXMT 或 DXVK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Bottle 設為使用 D3DMetal，但已安裝的引擎並未包含它。遊戲會退回使用 WineD3D，而它無法執行 DirectX 11 遊戲 — 請改用 DXMT 或 DXVK。"
          }
        }
      }
    },
    "config.graphics.backend.d3dMetal.summary" : {
