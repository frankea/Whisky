    "steam.launch.timeout" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تبدأ اللعبة خلال دقيقتين. قد تكون ما زالت قيد التحميل، أو أن التشغيل قد فشل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra se nespustila do dvou minut. Možná se stále načítá, nebo spuštění selhalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spillet startede ikke inden for to minutter. Det indlæses måske stadig, eller også mislykkedes starten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel wurde nicht innerhalb von zwei Minuten gestartet. Es lädt vielleicht noch, oder der Start ist fehlgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game didn't start within two minutes. It may still be loading, or the launch failed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game didn't start within two minutes. It may still be loading, or the launch failed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego no se ha iniciado en dos minutos. Puede que siga cargando o que el inicio haya fallado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peli ei käynnistynyt kahdessa minuutissa. Se voi yhä latautua tai käynnistys epäonnistui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu n'a pas démarré en deux minutes. Il est peut-être encore en cours de chargement, ou le lancement a échoué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco non si è avviato entro due minuti. Potrebbe essere ancora in caricamento oppure l'avvio non è riuscito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームが 2 分以内に起動しませんでした。まだ読み込み中か、起動に失敗した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 2분 안에 시작되지 않았습니다. 아직 로딩 중이거나 실행에 실패했을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De game is niet binnen twee minuten gestart. Mogelijk wordt hij nog geladen of is het starten mislukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gra nie uruchomiła się w ciągu dwóch minut. Może się jeszcze wczytywać albo uruchomienie się nie powiodło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo não iniciou em dois minutos. Ele pode ainda estar carregando ou a abertura falhou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo não arrancou em dois minutos. Pode ainda estar a carregar ou o arranque falhou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jocul nu a pornit în două minute. Poate încă se încarcă sau lansarea a eșuat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра не запустилась за две минуты. Возможно, она ещё загружается или запуск не удался."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelet startade inte inom två minuter. Det kanske fortfarande läses in, eller så misslyckades starten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun iki dakika içinde başlamadı. Hâlâ yükleniyor olabilir veya başlatma başarısız oldu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гра не запустилася за дві хвилини. Можливо, вона ще завантажується або запуск не вдався."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game không khởi động trong hai phút. Có thể game vẫn đang tải, hoặc việc khởi chạy đã thất bại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏未在两分钟内启动。它可能仍在载入，也可能启动失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲未在兩分鐘內啟動。它可能仍在載入，也可能啟動失敗。"
          }
        }
      }
