    "setup.uninstall.confirm.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إزالة بيئة تشغيل Wine فقط، أم إزالة كل ما خزّنه Whisky — بما في ذلك جميع الزجاجات؟\n\nإزالة كل شيء نهائية ولا يمكن التراجع عنها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit jen prostředí Wine, nebo vše, co si Whisky uložila — včetně všech lahví?\n\nOdstranění všeho je trvalé a nelze je vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du kun fjerne Wine-runtimen eller alt, hvad Whisky har arkiveret — inklusive alle flasker?\n\nAt fjerne alt er permanent og kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Wine-Runtime entfernen oder alles, was Whisky gesichert hat – einschließlich aller Flaschen?\n\nAlles zu entfernen ist endgültig und kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the Wine runtime only, or remove everything Whisky has stored — including all bottles?\n\nRemoving everything is permanent and cannot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the Wine runtime only, or remove everything Whisky has stored — including all bottles?\n\nRemoving everything is permanent and cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres eliminar solo el runtime de Wine o todo lo que Whisky ha guardado, incluidas todas las botellas?\n\nEliminarlo todo es permanente y no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko vain Wine-ajoympäristö vai kaikki Whiskyn tallentama — mukaan lukien kaikki pullot?\n\nKaiken poistaminen on lopullista eikä sitä voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer uniquement le runtime Wine, ou tout ce que Whisky a stocké, y compris toutes les bouteilles ?\n\nLa suppression complète est définitive et irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi rimuovere solo il runtime Wine oppure tutto ciò che Whisky ha salvato, incluse tutte le bottiglie?\n\nLa rimozione completa è definitiva e non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine ランタイムだけを削除しますか？ それとも、すべての Bottle を含め、Whisky が保存したデータをすべて削除しますか？\n\nすべて削除すると元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine 런타임만 제거하시겠습니까, 아니면 모든 Bottle을 포함해 Whisky가 저장한 모든 항목을 제거하시겠습니까?\n\n모두 제거하면 영구적이며 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de Wine-runtime verwijderen, of alles wat Whisky heeft bewaard — inclusief alle flessen?\n\nAlles verwijderen is definitief en kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć tylko silnik Wine czy wszystko, co przechowuje Whisky — w tym wszystkie butelki?\n\nUsunięcie wszystkiego jest trwałe i nieodwracalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover apenas o runtime do Wine ou tudo o que o Whisky armazenou, incluindo todas as Bottles?\n\nRemover tudo é permanente e não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover apenas o runtime do Wine ou tudo o que o Whisky guardou, incluindo todas as Bottles?\n\nRemover tudo é permanente e não pode ser anulado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimini doar runtime-ul Wine sau tot ce a stocat Whisky, inclusiv toate sticlele?\n\nEliminarea completă este definitivă și nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить только среду Wine или всё, что хранит Whisky, включая все бутылки?\n\nПолное удаление необратимо."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du ta bort enbart Wine-runtime eller allt som Whisky har sparat — inklusive alla flaskor?\n\nAtt ta bort allt är permanent och går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Wine çalışma zamanı mı kaldırılsın, yoksa Whisky'nin sakladığı her şey — tüm şişeler dahil — kaldırılsın mı?\n\nHer şeyi kaldırmak kalıcıdır ve geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити лише рушій Wine чи все, що зберігає Whisky, включно з усіма пляшками?\n\nПовне видалення незворотне."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gỡ runtime Wine, hay gỡ mọi thứ Whisky đã lưu — kể cả tất cả bottle?\n\nGỡ mọi thứ là vĩnh viễn và không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅移除 Wine 运行时，还是移除 Whisky 存储的所有内容（包括全部 Bottle）？\n\n移除全部内容是永久性的，且无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只移除 Wine 執行階段，還是移除 Whisky 儲存的所有內容（包括所有 Bottle）？\n\n全部移除是永久性的，且無法還原。"
          }
        }
      }
    },
