          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prefixo do Wine está danificado ou faltam-lhe pastas essenciais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefixul Wine este corupt sau îi lipsesc foldere esențiale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
