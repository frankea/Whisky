    "winetricks.error.missingAppData" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد AppData مفقود أو غير مكتمل. سيؤدي ذلك إلى فشل تثبيت التبعيات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složka AppData chybí nebo je neúplná. Instalace závislostí kvůli tomu selže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppData-mappen mangler eller er ufuldstændig. Det får installation af afhængigheder til at mislykkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der AppData-Ordner fehlt oder ist unvollständig. Dadurch schlagen Installationen von Abhängigkeiten fehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AppData directory is missing or incomplete. This will cause dependency installations to fail."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AppData directory is missing or incomplete. This will cause dependency installations to fail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la carpeta AppData o está incompleta. Las instalaciones de dependencias fallarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppData-kansio puuttuu tai on puutteellinen. Tämä saa riippuvuuksien asennukset epäonnistumaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier AppData est manquant ou incomplet. Les installations de dépendances échoueront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella AppData manca o è incompleta. Le installazioni delle dipendenze non andranno a buon fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppData フォルダが見つからないか、不完全です。このままでは依存関係のインストールに失敗します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppData 폴더가 없거나 불완전합니다. 이 상태에서는 의존성 설치가 실패합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AppData-map ontbreekt of is onvolledig. Hierdoor mislukken installaties van afhankelijkheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
