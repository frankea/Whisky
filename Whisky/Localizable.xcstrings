    "config.graphics.advancedActive" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التجاوزات المتقدمة نشطة. يظل المحدد البسيط مخفيًا حتى يتم مسحها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsou aktivní pokročilé přepisy. Jednoduchý výběr je skrytý, dokud je nezrušíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancerede tilsidesættelser er aktive. Den enkle vælger er skjult, indtil de fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Überschreibungen sind aktiv. Die einfache Auswahl wird erst wieder angezeigt, wenn sie entfernt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced overrides are active. The simple picker is hidden until they are cleared."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced overrides are active. The simple picker is hidden until they are cleared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay anulaciones avanzadas activas. El selector simple permanece oculto hasta que se borren."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisäasetusten ohitukset ovat käytössä. Perusvalitsin on piilotettu, kunnes ne tyhjennetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des réglages avancés sont actifs. Le sélecteur simple reste masqué tant qu'ils ne sont pas effacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono attivi override avanzati. Il selettore semplice resta nascosto finché non vengono rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細な上書きが有効です。これらを解除するまで、シンプルな選択肢は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고급 재정의가 적용되어 있습니다. 이를 해제할 때까지 간단 선택기는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geavanceerde overrides zijn actief. De eenvoudige keuzelijst blijft verborgen totdat ze zijn gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywne są zaawansowane zastąpienia. Prosty wybór jest ukryty, dopóki ich nie wyczyścisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há substituições avançadas ativas. O seletor simples fica oculto até que sejam removidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há substituições avançadas ativas. O seletor simples fica oculto até serem removidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt active suprascrieri avansate. Selectorul simplu rămâne ascuns până când sunt eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действуют расширенные замены. Простой выбор скрыт, пока они не сброшены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancerade åsidosättningar är aktiva. Den enkla väljaren visas igen när de har tagits bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişmiş geçersiz kılmalar etkin. Bunlar temizlenene kadar basit seçici gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діють розширені перевизначення. Простий вибір приховано, доки їх не скинуто."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi đè nâng cao đang bật. Bộ chọn đơn giản sẽ ẩn cho đến khi xóa các ghi đè này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已启用高级覆盖。在清除这些设置之前，简单选择器不会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用進階覆寫。在清除這些設定之前，簡易選擇器不會顯示。"
          }
        }
      }
    },
    "wine.dxmt.error.payloadMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT غير مضمّن في بيئة تشغيل Wine المثبتة. حدّث بيئة التشغيل من إعداد Whisky ثم أعد المحاولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT není součástí nainstalovaného prostředí Wine. Aktualizujte prostředí v nastavení Whisky a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT findes ikke i den installerede Wine-runtime. Opdater runtimen via Whiskys opsætning, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT ist in der installierten Wine-Runtime nicht enthalten. Aktualisiere die Runtime über die Einrichtung von Whisky und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT is not included in the installed Wine runtime. Update the runtime from Whisky's setup and try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT is not included in the installed Wine runtime. Update the runtime from Whisky's setup and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT no se incluye en el runtime de Wine instalado. Actualiza el runtime desde la configuración de Whisky e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT ei sisälly asennettuun Wine-ajoympäristöön. Päivitä ajoympäristö Whiskyn asennuksesta ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT n'est pas inclus dans le runtime Wine installé. Mettez le runtime à jour depuis la configuration de Whisky, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT non è incluso nel runtime Wine installato. Aggiorna il runtime dalla configurazione di Whisky e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みの Wine ランタイムに DXMT が含まれていません。Whisky のセットアップからランタイムをアップデートして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 Wine 런타임에 DXMT가 포함되어 있지 않습니다. Whisky 설정에서 런타임을 업데이트한 뒤 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT zit niet in de geïnstalleerde Wine-runtime. Werk de runtime bij via de setup van Whisky en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DXMT nie jest częścią zainstalowanego silnika Wine. Zaktualizuj silnik w konfiguracji Whisky i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DXMT não está incluído no runtime do Wine instalado. Atualize o runtime pela configuração do Whisky e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
