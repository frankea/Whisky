    "winetricks.error.corruptedPrefix" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بادئة Wine تالفة أو تنقصها مجلدات أساسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefix Wine je poškozený nebo v něm chybí důležité složky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine-præfikset er beskadiget eller mangler vigtige mapper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wine-Präfix ist beschädigt, oder es fehlen wichtige Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Wine prefix is corrupted or missing essential directories."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Wine prefix is corrupted or missing essential directories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El prefijo de Wine está dañado o le faltan carpetas esenciales."
