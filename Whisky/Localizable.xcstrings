    "setup.whiskywine.error.checksumMismatch" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تجتز بيئة تشغيل Wine التي تم تنزيلها فحص السلامة ولم يتم تثبيتها. يعني ذلك عادةً أن التنزيل تالف. يُرجى إعادة المحاولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažené prostředí Wine neprošlo kontrolou integrity a nebylo nainstalováno. Obvykle to znamená poškozené stažení. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hentede Wine-runtime bestod ikke integritetstjekket og blev ikke installeret. Det betyder som regel, at overførslen blev beskadiget. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geladene Wine-Runtime hat die Integritätsprüfung nicht bestanden und wurde nicht installiert. Meist ist der Download beschädigt. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded Wine runtime failed its integrity check and was not installed. This usually means the download was corrupted. Please try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded Wine runtime failed its integrity check and was not installed. This usually means the download was corrupted. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El runtime de Wine descargado no ha superado la comprobación de integridad y no se ha instalado. Suele deberse a una descarga dañada. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladattu Wine-ajoympäristö ei läpäissyt eheystarkistusta eikä sitä asennettu. Yleensä tämä tarkoittaa, että lataus vioittui. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le runtime Wine téléchargé n'a pas passé le contrôle d'intégrité et n'a pas été installé. Le téléchargement est probablement corrompu. Veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il runtime Wine scaricato non ha superato il controllo di integrità e non è stato installato. Di solito significa che il download è danneggiato. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした Wine ランタイムが整合性チェックに通らなかったため、インストールされませんでした。多くの場合、ダウンロードが破損しています。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 Wine 런타임이 무결성 검사를 통과하지 못해 설치되지 않았습니다. 대개 다운로드가 손상된 경우입니다. 다시 시도해 주십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedownloade Wine-runtime is niet door de integriteitscontrole gekomen en is niet geïnstalleerd. Meestal is de download beschadigd. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrany silnik Wine nie przeszedł kontroli integralności i nie został zainstalowany. Zwykle oznacza to uszkodzone pobieranie. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine baixado não passou na verificação de integridade e não foi instalado. Em geral, isso significa que o download foi corrompido. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine transferido não passou a verificação de integridade e não foi instalado. Normalmente, isto significa que a transferência ficou danificada. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runtime-ul Wine descărcat nu a trecut verificarea de integritate și nu a fost instalat. De obicei, asta înseamnă că descărcarea s-a corupt. Încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженная среда Wine не прошла проверку целостности и не была установлена. Обычно это означает, что загрузка повреждена. Попробуйте ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hämtade Wine-runtime klarade inte integritetskontrollen och installerades inte. Det beror oftast på att hämtningen skadades. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen Wine çalışma zamanı bütünlük denetiminden geçemedi ve yüklenmedi. Bu genellikle indirmenin bozulduğu anlamına gelir. Lütfen yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажений рушій Wine не пройшов перевірку цілісності й не був встановлений. Зазвичай це означає, що завантаження пошкоджено. Спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runtime Wine tải về không vượt qua kiểm tra toàn vẹn nên chưa được cài. Thường là do tệp tải về bị hỏng. Hãy thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的 Wine 运行时未通过完整性校验，因此未安装。这通常表示下载已损坏。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的 Wine 執行階段未通過完整性檢查，因此未安裝。這通常表示下載已損毀。請重試。"
          }
        }
      }
    },
