    "bottle.creation.error.runtimeMissing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيئة تشغيل Wine (WhiskyWine) غير مثبتة، لذا لا يمكن تهيئة الزجاجة. شغّل الإعداد لتنزيلها ثم أعد المحاولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostředí Wine (WhiskyWine) není nainstalováno, takže láhev nelze inicializovat. Spusťte nastavení, stáhněte je a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine-runtimen (WhiskyWine) er ikke installeret, så flasken kan ikke klargøres. Kør opsætningen for at hente den, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wine-Runtime (WhiskyWine) ist nicht installiert, daher kann die Flasche nicht initialisiert werden. Führe die Einrichtung aus, um sie zu laden, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Wine runtime (WhiskyWine) isn't installed, so the bottle can't be initialized. Run Setup to download it, then try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Wine runtime (WhiskyWine) isn't installed, so the bottle can't be initialised. Run Setup to download it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El runtime de Wine (WhiskyWine) no está instalado, así que la botella no se puede inicializar. Ejecuta la configuración para descargarlo e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine-ajoympäristöä (WhiskyWine) ei ole asennettu, joten pulloa ei voi alustaa. Lataa se suorittamalla asennus ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le runtime Wine (WhiskyWine) n'est pas installé, la bouteille ne peut donc pas être initialisée. Lancez la configuration pour le télécharger, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il runtime Wine (WhiskyWine) non è installato, quindi la bottiglia non può essere inizializzata. Esegui la configurazione per scaricarlo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine ランタイム (WhiskyWine) がインストールされていないため、Bottle を初期化できません。セットアップを実行してダウンロードしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine 런타임(WhiskyWine)이 설치되지 않아 Bottle을 초기화할 수 없습니다. 설정을 실행해 다운로드한 뒤 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Wine-runtime (WhiskyWine) is niet geïnstalleerd, dus de fles kan niet worden geïnitialiseerd. Voer de setup uit om deze te downloaden en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silnik Wine (WhiskyWine) nie jest zainstalowany, więc nie można zainicjować butelki. Uruchom konfigurację, aby go pobrać, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine (WhiskyWine) não está instalado, então a Bottle não pode ser inicializada. Execute a configuração para baixá-lo e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine (WhiskyWine) não está instalado, por isso a Bottle não pode ser inicializada. Execute a configuração para o transferir e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runtime-ul Wine (WhiskyWine) nu este instalat, așa că sticla nu poate fi inițializată. Rulează configurarea pentru a-l descărca, apoi încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среда Wine (WhiskyWine) не установлена, поэтому бутылку не удалось инициализировать. Запустите настройку, чтобы загрузить её, и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine-runtime (WhiskyWine) är inte installerad, så flaskan kan inte förberedas. Kör konfigurationen för att hämta den och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine çalışma zamanı (WhiskyWine) yüklü olmadığından şişe hazırlanamıyor. İndirmek için Kurulum'u çalıştırın, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рушій Wine (WhiskyWine) не встановлено, тому пляшку не вдалося ініціалізувати. Запустіть налаштування, щоб завантажити його, і спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa cài runtime Wine (WhiskyWine) nên không thể khởi tạo bottle. Hãy chạy phần cài đặt để tải về rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未安装 Wine 运行时（WhiskyWine），因此无法初始化 Bottle。请运行设置以下载，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未安裝 Wine 執行階段（WhiskyWine），因此無法初始化 Bottle。請執行設定流程下載後再試一次。"
          }
        }
      }
