    "launcher.diagnostics.export.error.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ أثناء حفظ تقرير التشخيص:\n\n%@\n\nيُرجى إعادة المحاولة أو اختيار موقع آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při ukládání diagnostické zprávy došlo k chybě:\n\n%@\n\nZkuste to znovu nebo vyberte jiné umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod en fejl, da diagnostikrapporten skulle arkiveres:\n\n%@\n\nPrøv igen, eller vælg en anden placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern des Diagnoseberichts ist ein Fehler aufgetreten:\n\n%@\n\nVersuche es erneut oder wähle einen anderen Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occurred while saving the diagnostics report:\n\n%@\n\nPlease try again or choose a different location."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occurred while saving the diagnostics report:\n\n%@\n\nPlease try again or choose a different location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha producido un error al guardar el informe de diagnóstico:\n\n%@\n\nInténtalo de nuevo o elige otra ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vianmääritysraportin tallentamisessa tapahtui virhe:\n\n%@\n\nYritä uudelleen tai valitse toinen sijainti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s'est produite lors de l'enregistrement du rapport de diagnostic :\n\n%@\n\nRéessayez ou choisissez un autre emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore durante il salvataggio del report diagnostico:\n\n%@\n\nRiprova o scegli un'altra posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断レポートの保存中にエラーが発生しました:\n\n%@\n\nもう一度試すか、別の保存場所を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진단 보고서를 저장하는 중 오류가 발생했습니다:\n\n%@\n\n다시 시도하거나 다른 위치를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een fout opgetreden bij het bewaren van het diagnoserapport:\n\n%@\n\nProbeer het opnieuw of kies een andere locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas zapisywania raportu diagnostycznego wystąpił błąd:\n\n%@\n\nSpróbuj ponownie lub wybierz inną lokalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao salvar o relatório de diagnóstico:\n\n%@\n\nTente novamente ou escolha outro local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao guardar o relatório de diagnóstico:\n\n%@\n\nTente novamente ou escolha outra localização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A apărut o eroare la salvarea raportului de diagnostic:\n\n%@\n\nÎncearcă din nou sau alege altă locație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сохранении отчёта диагностики произошла ошибка:\n\n%@\n\nПопробуйте ещё раз или выберите другое расположение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett fel uppstod när diagnostikrapporten skulle sparas:\n\n%@\n\nFörsök igen eller välj en annan plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanılama raporu kaydedilirken bir hata oluştu:\n\n%@\n\nLütfen yeniden deneyin veya farklı bir konum seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час збереження звіту діагностики сталася помилка:\n\n%@\n\nСпробуйте ще раз або виберіть інше розташування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi khi lưu báo cáo chẩn đoán:\n\n%@\n\nHãy thử lại hoặc chọn vị trí khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储诊断报告时出错：\n\n%@\n\n请重试或选择其他位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存診斷報告時發生錯誤：\n\n%@\n\n請重試或選擇其他位置。"
          }
        }
      }
    },
