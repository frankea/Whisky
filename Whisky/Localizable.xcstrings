        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on Winen järjestelmäprosessi. Sen lopettaminen voi vaikuttaa muihin käynnissä oleviin ohjelmiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit d'un processus système Wine. L'arrêter peut affecter les autres programmes en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è un processo di sistema di Wine. Terminarlo può influire su altri programmi in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Wine のシステムプロセスです。終了すると、ほかの実行中のプログラムに影響する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine 시스템 프로세스입니다. 종료하면 실행 중인 다른 프로그램에 영향을 줄 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een Wine-systeemproces. Het beëindigen kan andere actieve programma's beïnvloeden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To systemowy proces Wine. Jego zakończenie może wpłynąć na inne programy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um processo de sistema do Wine. Encerrá-lo pode afetar outros programas em execução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um processo de sistema do Wine. Terminá-lo pode afetar outros programas em execução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesta este un proces de sistem Wine. Oprirea lui poate afecta alte programe în execuție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
