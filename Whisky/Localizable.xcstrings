    "config.dxvk.async.info" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمّع المظللات في الخلفية لتقليل التقطيع، مع احتمال ضئيل لظهور خلل بصري قصير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiluje shadery na pozadí, omezuje sekání; zřídka se můžou objevit krátké grafické artefakty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompilerer shaders i baggrunden for at mindske hakken, med en lille risiko for kortvarige grafikfejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert Shader im Hintergrund, um Ruckler zu reduzieren – mit geringem Risiko kurzer Bildfehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compile shaders in the background to reduce stutter, with a small risk of brief visual glitches."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compile shaders in the background to reduce stutter, with a small risk of brief visual glitches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila los shaders en segundo plano para reducir los tirones, con un pequeño riesgo de fallos visuales breves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kääntää varjostimet taustalla nykimisen vähentämiseksi; pieni riski hetkellisistä visuaalisista häiriöistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compile les shaders en arrière-plan pour réduire les saccades, avec un faible risque de brefs défauts d'affichage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila gli shader in background per ridurre gli scatti, con un piccolo rischio di brevi glitch visivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェーダーをバックグラウンドでコンパイルしてカクつきを減らします。まれに一瞬の描画の乱れが起きることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 셰이더를 컴파일해 끊김을 줄입니다. 드물게 화면이 잠깐 깨질 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compileert shaders op de achtergrond om haperingen te verminderen, met een klein risico op korte beeldfouten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiluje shadery w tle, ograniczając przycięcia; rzadko mogą pojawić się krótkie artefakty graficzne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila shaders em segundo plano para reduzir engasgos, com um pequeno risco de falhas visuais rápidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila shaders em segundo plano para reduzir engasgos, com um pequeno risco de falhas visuais breves."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compilează shaderele în fundal pentru a reduce sacadările, cu un mic risc de scurte defecte vizuale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компилирует шейдеры в фоне, уменьшая подтормаживания; изредка возможны кратковременные графические артефакты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompilerar shaders i bakgrunden för att minska hack, med en liten risk för kortvariga grafikfel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takılmayı azaltmak için gölgelendiricileri arka planda derler; küçük bir görsel bozulma riski vardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компілює шейдери у фоні, зменшуючи підгальмовування; зрідка можливі короткочасні графічні артефакти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biên dịch shader ở nền để giảm giật, đổi lại có nguy cơ nhỏ xuất hiện lỗi hình ảnh thoáng qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台编译着色器以减少卡顿，但有极小概率出现短暂的画面异常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景編譯著色器以減少頓挫，但有極小機率出現短暫的畫面異常。"
          }
        }
      }
    },
