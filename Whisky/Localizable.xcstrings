        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1，保留 PlayStation 與 Switch 控制器的原生按鍵配置，而不轉換為 XInput 格式。"
          }
        }
      }
    },
    "Sets SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 to enable controller input when the game window doesn't have focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 لتفعيل إدخال وحدة التحكم عندما لا تكون نافذة اللعبة نشطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, aby ovladač fungoval, i když okno hry není aktivní."
