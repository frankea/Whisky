    "bottle.creation.preflight.insufficientSpace" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة خالية كافية لإنشاء زجاجة: المتاح %1$@، بينما المطلوب نحو %2$@. أفرغ بعض المساحة أو اختر قرصًا آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není dost volného místa pro vytvoření lahve: k dispozici %1$@, potřeba je asi %2$@. Uvolněte místo nebo vyberte jiný disk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke plads nok til at oprette en flaske: %1$@ tilgængelig, men der skal bruges cirka %2$@. Frigør plads, eller vælg en anden disk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht genug freier Speicherplatz vorhanden, um eine Flasche zu erstellen: %1$@ verfügbar, benötigt werden etwa %2$@. Gib Speicherplatz frei oder wähle ein anderes Volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn't enough free space to create a bottle: %1$@ available, but about %2$@ is needed. Free up space or choose another disk."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn't enough free space to create a bottle: %1$@ available, but about %2$@ is needed. Free up space or choose another disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio libre suficiente para crear una botella: %1$@ disponibles, pero se necesitan unos %2$@. Libera espacio o elige otro disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pullon luomiseen ei ole tarpeeksi vapaata tilaa: käytettävissä %1$@, tarvitaan noin %2$@. Vapauta tilaa tai valitse toinen levy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace disque insuffisant pour créer une bouteille : %1$@ disponibles, environ %2$@ nécessaires. Libérez de l'espace ou choisissez un autre disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio libero insufficiente per creare una bottiglia: %1$@ disponibili, ma ne servono circa %2$@. Libera spazio o scegli un altro disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottle を作成するのに十分な空き容量がありません。使用可能: %1$@、必要な容量: 約 %2$@。空き容量を増やすか、別のディスクを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottle을 생성할 공간이 부족합니다. 사용 가능: %1$@, 필요: 약 %2$@. 공간을 확보하거나 다른 디스크를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is niet genoeg vrije ruimte om een fles aan te maken: %1$@ beschikbaar, terwijl ongeveer %2$@ nodig is. Maak ruimte vrij of kies een andere schijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mało wolnego miejsca, aby utworzyć butelkę: dostępne %1$@, a potrzeba około %2$@. Zwolnij miejsce lub wybierz inny dysk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço livre suficiente para criar uma Bottle: %1$@ disponíveis, mas são necessários cerca de %2$@. Libere espaço ou escolha outro disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço livre suficiente para criar uma Bottle: %1$@ disponíveis, mas são necessários cerca de %2$@. Liberte espaço ou escolha outro disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este destul spațiu liber pentru a crea o sticlă: %1$@ disponibili, dar sunt necesari aproximativ %2$@. Eliberează spațiu sau alege alt disc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободного места для создания бутылки: доступно %1$@, а нужно около %2$@. Освободите место или выберите другой диск."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inte tillräckligt med ledigt utrymme för att skapa en flaska: %1$@ tillgängligt, men cirka %2$@ krävs. Frigör utrymme eller välj en annan disk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şişe oluşturmak için yeterli boş alan yok: %1$@ kullanılabilir, ancak yaklaşık %2$@ gerekiyor. Yer açın veya başka bir disk seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостатньо вільного місця для створення пляшки: доступно %1$@, а потрібно близько %2$@. Звільніть місце або виберіть інший диск."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ dung lượng trống để tạo bottle: còn %1$@, cần khoảng %2$@. Hãy giải phóng dung lượng hoặc chọn ổ đĩa khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间不足，无法创建 Bottle：可用 %1$@，约需 %2$@。请释放空间或选择其他磁盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空間不足，無法建立 Bottle：可用 %1$@，約需 %2$@。請釋出空間或選擇其他磁碟。"
          }
        }
      }
    },
    "bottle.creation.preflight.notWritable" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر على Whisky الكتابة في المجلد الذي اخترته (%@). اختر مجلدًا يمكنك تعديله، مثل مجلد داخل مجلد المستخدم الخاص بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nemůže zapisovat do vybrané složky (%@). Vyberte složku, kterou můžete měnit, například ve vaší domovské složce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kan ikke skrive til den valgte mappe (%@). Vælg en mappe, du kan ændre, f.eks. en mappe i din hjemmemappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kann nicht in den gewählten Ordner schreiben (%@). Wähle einen Ordner, den du ändern kannst, zum Beispiel einen in deinem Benutzerordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky can't write to the folder you chose (%@). Pick a folder you can modify, such as one inside your home folder."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky can't write to the folder you chose (%@). Pick a folder you can modify, such as one inside your home folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky no puede escribir en la carpeta que has elegido (%@). Elige una carpeta que puedas modificar, por ejemplo dentro de tu carpeta de inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky ei voi kirjoittaa valitsemaasi kansioon (%@). Valitse kansio, jota voit muokata, esimerkiksi kotikansiostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky ne peut pas écrire dans le dossier choisi (%@). Choisissez un dossier que vous pouvez modifier, par exemple dans votre dossier de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky non può scrivere nella cartella che hai scelto (%@). Scegli una cartella che puoi modificare, ad esempio all'interno della tua cartella Inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダ (%@) に Whisky が書き込めません。ホームフォルダ内など、変更できるフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky가 선택한 폴더(%@)에 쓸 수 없습니다. 홈 폴더 안처럼 수정할 수 있는 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kan niet schrijven naar de gekozen map (%@). Kies een map die je kunt wijzigen, bijvoorbeeld een map in je thuismap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nie może zapisywać w wybranym folderze (%@). Wybierz folder, który możesz modyfikować, na przykład w folderze domowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whisky não consegue gravar na pasta que você escolheu (%@). Escolha uma pasta que você possa modificar, como uma dentro da sua pasta pessoal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whisky não consegue escrever na pasta que escolheu (%@). Escolha uma pasta que possa modificar, por exemplo dentro da sua pasta pessoal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nu poate scrie în folderul ales (%@). Alege un folder pe care îl poți modifica, de exemplu unul din folderul tău personal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky не может записывать в выбранную папку (%@). Выберите папку, доступную для изменения, например внутри вашей домашней папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kan inte skriva till mappen du valde (%@). Välj en mapp som du kan ändra i, till exempel en mapp i din hemmapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky seçtiğiniz klasöre (%@) yazamıyor. Ana klasörünüzdeki gibi değiştirebileceğiniz bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky не може записувати в обрану теку (%@). Виберіть теку, доступну для змін, наприклад усередині вашої домашньої теки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky không ghi được vào thư mục bạn đã chọn (%@). Hãy chọn thư mục bạn có quyền sửa đổi, chẳng hạn trong thư mục nhà của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky 无法写入你选择的文件夹（%@）。请选择一个你可以修改的文件夹，例如个人文件夹中的位置。"
