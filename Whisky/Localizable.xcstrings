    "settings.gptk.capability.blocked" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع إصدار المحرك المثبت تشغيل D3DMetal بعد. تُحفظ الحزم المستوردة وتُنشر تلقائيًا بمجرد تثبيت محرك يدعم GPTK."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainstalované sestavení prostředí zatím neumí spustit D3DMetal. Importované balíčky zůstanou uložené a nasadí se automaticky, jakmile bude nainstalováno prostředí s podporou GPTK."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det installerede engine-build kan ikke køre D3DMetal endnu. Importerede payloads bevares og installeres automatisk, når der er installeret en engine, der understøtter GPTK."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der installierte Engine-Build kann D3DMetal noch nicht ausführen. Importierte Payloads bleiben erhalten und werden automatisch bereitgestellt, sobald eine GPTK-fähige Engine installiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed engine build cannot run D3DMetal yet. Imported payloads are kept and deploy automatically once a GPTK-capable engine is installed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed engine build cannot run D3DMetal yet. Imported payloads are kept and deploy automatically once a GPTK-capable engine is installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión del motor instalada aún no puede ejecutar D3DMetal. Los paquetes importados se conservan y se despliegan automáticamente en cuanto se instale un motor compatible con GPTK."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asennettu moottoriversio ei vielä pysty ajamaan D3DMetalia. Tuodut paketit säilytetään ja otetaan automaattisesti käyttöön, kun GPTK-yhteensopiva moottori asennetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version du moteur installée ne peut pas encore exécuter D3DMetal. Les contenus importés sont conservés et se déploieront automatiquement dès qu'un moteur compatible GPTK sera installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La build del motore installata non può ancora eseguire D3DMetal. I pacchetti importati vengono conservati e distribuiti automaticamente non appena viene installato un motore compatibile con GPTK."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのエンジンビルドではまだ D3DMetal を実行できません。読み込んだペイロードは保持され、GPTK に対応したエンジンがインストールされると自動的に配置されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 엔진 빌드는 아직 D3DMetal을 실행할 수 없습니다. 가져온 페이로드는 유지되며, GPTK를 지원하는 엔진이 설치되면 자동으로 배포됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geïnstalleerde engine-build kan D3DMetal nog niet draaien. Geïmporteerde payloads blijven bewaard en worden automatisch uitgerold zodra er een GPTK-geschikte engine is geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstalowana wersja silnika nie obsługuje jeszcze D3DMetal. Zaimportowane pakiety są zachowywane i wdrożą się automatycznie po zainstalowaniu silnika zgodnego z GPTK."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão do motor instalada ainda não roda o D3DMetal. Os pacotes importados são mantidos e implantados automaticamente assim que um motor compatível com o GPTK for instalado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão do motor instalada ainda não consegue executar o D3DMetal. Os pacotes importados são mantidos e implementados automaticamente assim que for instalado um motor compatível com o GPTK."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiunea de motor instalată nu poate rula încă D3DMetal. Pachetele importate sunt păstrate și se instalează automat imediat ce este instalat un motor compatibil cu GPTK."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленная сборка среды пока не может запускать D3DMetal. Импортированные пакеты сохраняются и развернутся автоматически, когда появится среда с поддержкой GPTK."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det installerade motorbygget kan inte köra D3DMetal ännu. Importerade payloads sparas och installeras automatiskt när en GPTK-kompatibel motor har installerats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü motor sürümü henüz D3DMetal'i çalıştıramıyor. İçe aktarılan paketler saklanır ve GPTK uyumlu bir motor yüklendiğinde otomatik olarak dağıtılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлена збірка рушія поки не може запускати D3DMetal. Імпортовані пакети зберігаються й розгорнуться автоматично, коли з'явиться рушій із підтримкою GPTK."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng engine đã cài chưa chạy được D3DMetal. Các gói đã nhập vẫn được giữ và tự động triển khai khi cài engine hỗ trợ GPTK."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的引擎版本尚无法运行 D3DMetal。已导入的负载会保留，并在安装支持 GPTK 的引擎后自动部署。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝的引擎版本尚無法執行 D3DMetal。已匯入的酬載會保留，並在安裝支援 GPTK 的引擎後自動部署。"
          }
        }
      }
    },
