        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, så controlleren virker, når spilvinduet ikke er i forgrunden."
