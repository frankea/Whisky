    "setup.whiskywine.error.tarballMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيئة تشغيل Wine التي تم تنزيلها مفقودة ولا يمكن تثبيتها. على الأرجح أُزيلت قبل اكتمال التثبيت. يُرجى إعادة المحاولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažené prostředí Wine chybí, a proto je nelze nainstalovat. Pravděpodobně bylo odstraněno před dokončením instalace. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hentede Wine-runtime mangler og kan ikke installeres. Den blev sandsynligvis fjernet, før installationen var færdig. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geladene Wine-Runtime fehlt und kann nicht installiert werden. Vermutlich wurde sie entfernt, bevor die Installation abgeschlossen war. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded Wine runtime is missing and can't be installed. It was likely removed before installation finished. Please try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded Wine runtime is missing and can't be installed. It was likely removed before installation finished. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El runtime de Wine descargado no está y no se puede instalar. Es probable que se eliminara antes de terminar la instalación. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladattu Wine-ajoympäristö puuttuu eikä sitä voi asentaa. Se poistettiin todennäköisesti ennen asennuksen valmistumista. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le runtime Wine téléchargé est introuvable et ne peut pas être installé. Il a probablement été supprimé avant la fin de l'installation. Veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il runtime Wine scaricato non è presente e non può essere installato. Probabilmente è stato rimosso prima del termine dell'installazione. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした Wine ランタイムが見つからないため、インストールできません。インストールが完了する前に削除された可能性があります。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 Wine 런타임이 없어 설치할 수 없습니다. 설치가 끝나기 전에 삭제된 것으로 보입니다. 다시 시도해 주십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedownloade Wine-runtime ontbreekt en kan niet worden geïnstalleerd. Waarschijnlijk is deze verwijderd voordat de installatie klaar was. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje pobranego silnika Wine, więc nie można go zainstalować. Prawdopodobnie został usunięty przed zakończeniem instalacji. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine baixado não está presente e não pode ser instalado. Provavelmente foi removido antes de a instalação terminar. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime do Wine transferido não está presente e não pode ser instalado. Provavelmente foi removido antes de a instalação terminar. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runtime-ul Wine descărcat lipsește și nu poate fi instalat. Probabil a fost șters înainte de finalizarea instalării. Încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженная среда Wine отсутствует, поэтому установить её не удалось. Скорее всего, файл был удалён до завершения установки. Попробуйте ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hämtade Wine-runtime saknas och kan inte installeras. Den togs troligen bort innan installationen var klar. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen Wine çalışma zamanı bulunamadığı için yüklenemiyor. Büyük olasılıkla yükleme tamamlanmadan kaldırıldı. Lütfen yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаженого рушія Wine немає, тому встановити його не вдалося. Найімовірніше, файл видалено до завершення встановлення. Спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy runtime Wine đã tải nên không thể cài. Có thể nó đã bị xóa trước khi cài xong. Hãy thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的 Wine 运行时已丢失，无法安装。它可能在安装完成前被移除。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的 Wine 執行階段已遺失，無法安裝。它可能在安裝完成前被移除。請重試。"
          }
        }
      }
    },
