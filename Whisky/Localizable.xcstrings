    "config.winVersion.info" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصدار Windows الذي يبلّغ عنه Wine للبرامج. يناسب Windows 10 معظم التطبيقات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze Windows, kterou Wine hlásí programům. Většině aplikací vyhovuje Windows 10."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Windows-version, som Wine oplyser til programmer. Windows 10 passer til de fleste apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Windows-Version, die Wine an Programme meldet. Windows 10 passt für die meisten Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Windows version Wine reports to programs. Windows 10 suits most apps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Windows version Wine reports to programs. Windows 10 suits most apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión de Windows que Wine informa a los programas. Windows 10 sirve para la mayoría de apps."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows-versio, jonka Wine ilmoittaa ohjelmille. Windows 10 sopii useimmille sovelluksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version de Windows que Wine signale aux programmes. Windows 10 convient à la plupart des apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione di Windows che Wine comunica ai programmi. Windows 10 va bene per quasi tutte le app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine がプログラムに報告する Windows のバージョンです。ほとんどのアプリには Windows 10 が適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine이 프로그램에 보고하는 Windows 버전입니다. 대부분의 앱에는 Windows 10이 적합합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Windows-versie die Wine aan programma's meldt. Windows 10 voldoet voor de meeste apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja Windows zgłaszana programom przez Wine. Windows 10 pasuje do większości aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão do Windows que o Wine informa aos programas. O Windows 10 atende à maioria dos apps."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão do Windows que o Wine comunica aos programas. O Windows 10 serve para a maioria das apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiunea de Windows raportată de Wine. Windows 10 e potrivit pentru majoritatea aplicațiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия Windows, о которой Wine сообщает программам. Для большинства подходит Windows 10."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Windows-version som Wine rapporterar till program. Windows 10 passar de flesta appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine'ın programlara bildirdiği Windows sürümü. Çoğu uygulama için Windows 10 uygundur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
