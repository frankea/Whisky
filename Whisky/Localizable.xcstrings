    "config.retinaMode.info" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض بدقة Retina الكاملة للحصول على صورة أوضح. عطّله إذا بدت اللعبة صغيرة جدًا أو كانت بطيئة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresluje v plném rozlišení Retina pro ostřejší obraz. Vypněte, pokud hra vypadá drobně nebo běží pomalu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderer i fuld Retina-opløsning for et skarpere billede. Slå fra, hvis et spil ser bittesmåt ud eller kører langsomt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendert in voller Retina-Auflösung für ein schärferes Bild. Deaktivieren, wenn Spiele winzig wirken oder langsam laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Render at full Retina resolution for sharper output. Disable if a game looks tiny or runs slowly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Render at full Retina resolution for sharper output. Disable if a game looks tiny or runs slowly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza a resolución Retina completa para una imagen más nítida. Desactívalo si un juego se ve diminuto o va lento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtää täydellä Retina-tarkkuudella terävämpää kuvaa. Poista käytöstä, jos peli näyttää pieneltä tai on hidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche en pleine résolution Retina pour une image plus nette. Désactivez si un jeu paraît minuscule ou devient lent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendering a risoluzione Retina completa per immagini più nitide. Disattivalo se il gioco appare minuscolo o è lento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina の解像度のまま描画し、より鮮明に表示します。ゲームが小さく表示されたり動作が重い場合はオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina 해상도 그대로 렌더링해 더 선명하게 표시합니다. 게임이 너무 작게 보이거나 느리면 끄십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendert op volle Retina-resolutie voor een scherper beeld. Schakel dit uit als een game klein oogt of traag draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderuje w pełnej rozdzielczości Retina dla ostrzejszego obrazu. Wyłącz, jeśli gra jest maleńka lub działa wolno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza na resolução Retina completa para uma imagem mais nítida. Desative se um jogo ficar minúsculo ou lento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza na resolução Retina completa para uma imagem mais nítida. Desative se um jogo ficar minúsculo ou lento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randează la rezoluție Retina completă, pentru imagine mai clară. Dezactivează dacă jocul apare minuscul sau merge greu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг в полном разрешении Retina для чёткой картинки. Отключите, если игра выглядит крошечной или тормозит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderar i full Retina-upplösning för skarpare bild. Stäng av om ett spel ser pyttelitet ut eller går långsamt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha net görüntü için tam Retina çözünürlüğünde işler. Oyun çok küçük görünüyorsa veya yavaş çalışıyorsa kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг із повною роздільною здатністю Retina для чіткішої картинки. Вимкніть, якщо гра дрібна або гальмує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết xuất ở độ phân giải Retina đầy đủ để hình ảnh sắc nét hơn. Tắt nếu game trông quá nhỏ hoặc chạy chậm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以完整 Retina 分辨率渲染，画面更清晰。如果游戏显示过小或运行缓慢，请关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以完整 Retina 解析度算繪，畫面更清晰。如果遊戲顯示過小或執行緩慢，請關閉。"
          }
        }
      }
    },
