    "bottle.remove.hasProcesses.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد عمليات Wine قيد التشغيل في هذه الزجاجة. سيتم إيقافها قبل إزالة الزجاجة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V této lahvi běží procesy Wine. Před odstraněním lahve budou zastaveny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kører Wine-processer i denne flaske. De bliver stoppet, før flasken fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Flasche laufen Wine-Prozesse. Sie werden gestoppt, bevor die Flasche entfernt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are Wine processes running in this bottle. They will be stopped before the bottle is removed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are Wine processes running in this bottle. They will be stopped before the bottle is removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay procesos de Wine en ejecución en esta botella. Se detendrán antes de eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä pullossa on käynnissä Wine-prosesseja. Ne pysäytetään ennen pullon poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des processus Wine sont en cours d'exécution dans cette bouteille. Ils seront arrêtés avant sa suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa bottiglia ci sono processi Wine in esecuzione. Verranno arrestati prima della rimozione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Bottle で Wine のプロセスが実行中です。Bottle を削除する前に停止されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Bottle에서 Wine 프로세스가 실행 중입니다. Bottle을 삭제하기 전에 중지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deze fles draaien Wine-processen. Ze worden gestopt voordat de fles wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej butelce działają procesy Wine. Zostaną zatrzymane przed usunięciem butelki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há processos do Wine em execução nesta Bottle. Eles serão parados antes de a Bottle ser removida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existem processos do Wine em execução nesta Bottle. Serão parados antes de a Bottle ser removida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În această sticlă rulează procese Wine. Vor fi oprite înainte de eliminarea sticlei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой бутылке выполняются процессы Wine. Перед удалением бутылки они будут остановлены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det körs Wine-processer i den här flaskan. De stoppas innan flaskan tas bort."
          }
        },
        "tr" : {
          "stringUnit" : {
