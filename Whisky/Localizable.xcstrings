    "bottle.registry.corrupt.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Whisky قراءة قائمة الزجاجات المحفوظة، لذا تم إنشاء قائمة فارغة جديدة. نُقل الملف غير القابل للقراءة إلى «%@». ولم تُحذف مجلدات الزجاجات على القرص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nedokázala přečíst uložený seznam lahví, a proto vytvořila nový prázdný. Nečitelný soubor byl přesunut do „%@“. Složky lahví na disku zůstaly zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kunne ikke læse den arkiverede liste over flasker og oprettede derfor en ny, tom liste. Den ulæselige fil blev flyttet til “%@”. Dine flaskemapper på disken blev ikke slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky konnte die gesicherte Flaschenliste nicht lesen und hat eine neue, leere Liste angelegt. Die unlesbare Datei wurde nach „%@“ verschoben. Deine Flaschenordner auf der Festplatte wurden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky couldn't read its saved bottle list, so a fresh empty list was created. The unreadable file was moved to “%@”. Your bottle folders on disk were not deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky couldn't read its saved bottle list, so a fresh empty list was created. The unreadable file was moved to “%@”. Your bottle folders on disk were not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky no ha podido leer su lista de botellas guardada, así que se ha creado una lista vacía. El archivo ilegible se ha movido a «%@». Las carpetas de tus botellas en el disco no se han borrado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky ei voinut lukea tallennettua pulloluetteloa, joten tilalle luotiin tyhjä luettelo. Lukukelvoton tiedosto siirrettiin sijaintiin ”%@”. Levyllä olevia pullokansioitasi ei poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky n'a pas pu lire sa liste de bouteilles enregistrée ; une nouvelle liste vide a été créée. Le fichier illisible a été déplacé vers « %@ ». Vos dossiers de bouteilles sur le disque n'ont pas été supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky non è riuscito a leggere l'elenco delle bottiglie salvato, perciò ne è stato creato uno nuovo e vuoto. Il file illeggibile è stato spostato in «%@». Le cartelle delle bottiglie sul disco non sono state eliminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky は保存されていた Bottle の一覧を読み込めなかったため、空の一覧を新しく作成しました。読み込めなかったファイルは「%@」に移動しました。ディスク上の Bottle のフォルダは削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky가 저장된 Bottle 목록을 읽지 못해 새 빈 목록을 만들었습니다. 읽을 수 없던 파일은 “%@”(으)로 옮겼습니다. 디스크의 Bottle 폴더는 삭제되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kon de bewaarde flessenlijst niet lezen en heeft een nieuwe, lege lijst aangemaakt. Het onleesbare bestand is verplaatst naar “%@”. Je flesmappen op de schijf zijn niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nie mógł odczytać zapisanej listy butelek, więc utworzył nową, pustą listę. Nieczytelny plik został przeniesiony do „%@”. Foldery butelek na dysku nie zostały usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whisky não conseguiu ler a lista de Bottles salva, então uma lista vazia foi criada. O arquivo ilegível foi movido para “%@”. As pastas das suas Bottles no disco não foram apagadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whisky não conseguiu ler a lista de Bottles guardada, por isso foi criada uma lista vazia. O ficheiro ilegível foi movido para «%@». As pastas das suas Bottles no disco não foram eliminadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky nu a putut citi lista de sticle salvată, așa că a fost creată o listă nouă, goală. Fișierul ilizibil a fost mutat în „%@”. Folderele sticlelor de pe disc nu au fost șterse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky не смог прочитать сохранённый список бутылок и создал новый пустой список. Нечитаемый файл перемещён в «%@». Папки бутылок на диске не удалены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kunde inte läsa den sparade listan över flaskor och skapade därför en ny, tom lista. Den oläsbara filen flyttades till ”%@”. Dina flaskmappar på disken raderades inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky kayıtlı şişe listesini okuyamadı, bu yüzden yeni ve boş bir liste oluşturuldu. Okunamayan dosya “%@” konumuna taşındı. Diskteki şişe klasörleriniz silinmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky не зміг прочитати збережений список пляшок, тому створив новий порожній список. Нечитабельний файл перенесено до «%@». Теки пляшок на диску не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky không đọc được danh sách bottle đã lưu nên đã tạo danh sách trống mới. Tệp không đọc được đã chuyển tới “%@”. Các thư mục bottle trên ổ đĩa không bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky 无法读取已存储的 Bottle 列表，因此新建了一个空列表。无法读取的文件已移至“%@”。磁盘上的 Bottle 文件夹未被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisky 無法讀取已儲存的 Bottle 列表，因此建立了一個新的空白列表。無法讀取的檔案已移至「%@」。磁碟上的 Bottle 檔案夾並未刪除。"
          }
        }
      }
    },
