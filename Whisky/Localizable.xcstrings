    "setup.whiskywine.error.interrupted" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال ولم يكتمل التنزيل. يرجى المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení bylo přerušeno a stahování se nepodařilo dokončit. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt, og overførslen kunne ikke fuldføres. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung wurde unterbrochen und der Download konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was interrupted and the download could not be completed. Please try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was interrupted and the download could not be completed. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió la conexión y no se pudo completar la descarga. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi, eikä latausta voitu suorittaa loppuun. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été interrompue et le téléchargement n'a pas pu être terminé. Veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta e non è stato possibile completare il download. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が中断されたため、ダウンロードを完了できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 중단되어 다운로드를 완료할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nl" : {
