    "settings.toggle.menubar.help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف عنصرًا في شريط القوائم لتشغيل البرامج المثبّتة في القائمة، ويُبقي Whisky يعمل بعد إغلاق نافذته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá položku do řádku nabídek pro spouštění připnutých programů a nechá Whisky běžet i po zavření okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer et emne i menulinjen til at starte fastgjorte programmer og holder Whisky kørende, efter at vinduet er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt ein Menüleisten-Symbol zum Starten angehefteter Programme hinzu und hält Whisky nach dem Schließen des Fensters aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a menu-bar item for launching pinned programs, and keep Whisky running after its window is closed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a menu-bar item for launching pinned programs, and keep Whisky running after its window is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un ítem en la barra de menús para abrir programas anclados y mantiene Whisky activo tras cerrar su ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää valikkoriville kohteen, josta voit käynnistää kiinnitettyjä ohjelmia, ja pitää Whiskyn käynnissä ikkunan sulkemisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un élément de barre des menus pour lancer les programmes épinglés et garde Whisky ouvert après la fermeture de sa fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un elemento nella barra dei menu per avviare i programmi fissati e mantiene Whisky attivo dopo la chiusura della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めしたプログラムを起動できるメニューバー項目を追加し、ウインドウを閉じたあとも Whisky を実行し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 프로그램을 실행할 수 있는 메뉴 막대 항목을 추가하고, 윈도우를 닫은 뒤에도 Whisky를 계속 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een menubalksymbool toe voor het starten van vastgezette programma's en houdt Whisky actief nadat het venster is gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje pozycję na pasku menu do uruchamiania przypiętych programów i utrzymuje Whisky po zamknięciu okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um item na barra de menus para abrir programas fixados e mantém o Whisky em execução depois que a janela é fechada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um item na barra de menus para abrir programas fixados e mantém o Whisky em execução depois de fechar a janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un element în bara de meniu pentru lansarea programelor fixate și menține Whisky pornit după închiderea ferestrei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет объект в строку меню для запуска закреплённых программ и оставляет Whisky работать после закрытия окна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till ett objekt i menyraden för att starta fästa program och håller Whisky igång efter att fönstret har stängts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlenmiş programları başlatmak için bir menü çubuğu ögesi ekler ve penceresi kapatıldıktan sonra Whisky'yi çalışır durumda tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає об'єкт у рядок меню для запуску закріплених програм і залишає Whisky працювати після закриття вікна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một mục trên thanh menu để khởi chạy các chương trình đã ghim, và giữ Whisky chạy sau khi đóng cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加菜单栏项以启动已固定的程序，并在关闭窗口后让 Whisky 继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入選單列項目以啟動釘選的程式，並在關閉視窗後讓 Whisky 繼續執行。"
          }
        }
      }
    },
