    "gameConfig.revert.confirm.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُستعاد الإعدادات إلى حالتها قبل تطبيق تكوين اللعبة. وستبقى مكونات winetricks المثبتة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení se vrátí do stavu před použitím herní konfigurace. Nainstalované komponenty winetricks zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingerne gendannes til, som de var, før spilkonfigurationen blev anvendt. Installerede winetricks-komponenter bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen werden auf den Stand vor dem Anwenden der Spielkonfiguration zurückgesetzt. Installierte Winetricks-Komponenten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings will be restored to their state before the game configuration was applied. Installed winetricks components will remain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings will be restored to their state before the game configuration was applied. Installed winetricks components will remain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes volverán al estado que tenían antes de aplicar la configuración del juego. Los componentes de winetricks instalados se mantendrán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetukset palautetaan tilaan, joka oli ennen pelimäärityksen käyttöönottoa. Asennetut winetricks-komponentit säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages seront restaurés dans l'état où ils étaient avant l'application de la configuration de jeu. Les composants winetricks installés seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni verranno ripristinate allo stato precedente all'applicazione della configurazione di gioco. I componenti winetricks installati resteranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム構成を適用する前の状態に設定が戻ります。インストール済みの winetricks コンポーネントはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 구성을 적용하기 전 상태로 설정이 복원됩니다. 설치된 winetricks 구성 요소는 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instellingen worden teruggezet naar hoe ze waren voordat de gameconfiguratie werd toegepast. Geïnstalleerde winetricks-onderdelen blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia wrócą do stanu sprzed zastosowania konfiguracji gry. Zainstalowane składniki winetricks pozostaną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações voltarão ao estado anterior à aplicação da configuração do jogo. Os componentes do winetricks instalados serão mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As definições serão repostas no estado em que estavam antes de a configuração do jogo ser aplicada. Os componentes do winetricks instalados vão manter-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările vor fi readuse la starea de dinainte de aplicarea configurației de joc. Componentele winetricks instalate rămân."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки вернутся к состоянию до применения игровой конфигурации. Установленные компоненты winetricks останутся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningarna återställs till hur de var innan spelkonfigurationen tillämpades. Installerade winetricks-komponenter behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar, oyun yapılandırması uygulanmadan önceki durumuna döndürülecek. Yüklenen winetricks bileşenleri kalacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування повернуться до стану перед застосуванням ігрової конфігурації. Встановлені компоненти winetricks залишаться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cài đặt sẽ được khôi phục về trạng thái trước khi áp dụng cấu hình game. Các thành phần winetricks đã cài vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置将恢复到应用游戏配置之前的状态。已安装的 winetricks 组件将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定會回復到套用遊戲組態之前的狀態。已安裝的 winetricks 元件會保留。"
          }
        }
      }
    },
