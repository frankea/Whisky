    "process.detail.systemWarning" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه عملية نظام تابعة لـ Wine. قد يؤثر إنهاؤها على برامج أخرى قيد التشغيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je systémový proces Wine. Jeho ukončení může ovlivnit další programy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en Wine-systemproces. Hvis du afbryder den, kan det påvirke andre kørende programmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein Wine-Systemprozess. Ihn zu beenden, kann andere laufende Programme beeinträchtigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a Wine system process. Killing it may affect other running programs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a Wine system process. Killing it may affect other running programs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un proceso del sistema de Wine. Cerrarlo puede afectar a otros programas en ejecución."
