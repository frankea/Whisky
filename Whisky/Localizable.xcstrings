    "controller.bluetooth.warning" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تؤدي انقطاعات Bluetooth إلى تعطيل الإدخال، وUSB أكثر موثوقية"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výpadky Bluetooth kazí vstup; USB je spolehlivější"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-udfald kan ødelægge input; USB er mere pålideligt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-Aussetzer können die Eingabe stören; USB ist zuverlässiger"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth dropouts can break input; USB is more reliable"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth dropouts can break input; USB is more reliable"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cortes de Bluetooth pueden bloquear la entrada; el USB es más fiable"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-katkokset voivat estää syötteen; USB on luotettavampi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coupures Bluetooth peuvent bloquer les entrées ; l'USB est plus fiable"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le interruzioni Bluetooth possono bloccare l'input; l'USB è più affidabile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth が途切れると入力が効かなくなることがあります。USB のほうが安定します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth가 끊기면 입력이 안 될 수 있습니다. USB가 더 안정적입니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-uitval kan invoer verstoren; USB is betrouwbaarder"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrywanie Bluetooth psuje sterowanie; USB jest pewniejsze"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedas de Bluetooth podem travar a entrada; o USB é mais confiável"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quebras de Bluetooth podem afetar a entrada; o USB é mais fiável"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreruperile Bluetooth pot bloca intrarea; USB este mai fiabil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрывы Bluetooth ломают ввод; по USB надёжнее"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
