          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Windows build number Wine reports. Leave unset unless a program needs a specific build."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Windows build number Wine reports. Leave unset unless a program needs a specific build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de compilación de Windows que informa Wine. Déjalo sin definir salvo que un programa necesite uno concreto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows-koontiversion numero, jonka Wine ilmoittaa. Jätä asettamatta, ellei ohjelma vaadi tiettyä koontiversiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le numéro de build Windows signalé par Wine. À laisser vide sauf si un programme exige un build précis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di build di Windows dichiarato da Wine. Lascialo vuoto se nessun programma richiede una build specifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine が報告する Windows のビルド番号です。特定のビルドを必要とするプログラムがなければ、未設定のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine이 보고하는 Windows 빌드 번호입니다. 특정 빌드가 필요한 프로그램이 없다면 설정하지 마십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Windows-buildnummer dat Wine meldt. Laat dit leeg, tenzij een programma een specifieke build nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numer kompilacji Windows zgłaszany przez Wine. Zostaw pusty, chyba że program wymaga konkretnej kompilacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O número de compilação do Windows que o Wine informa. Deixe sem definir a menos que um programa exija um específico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
